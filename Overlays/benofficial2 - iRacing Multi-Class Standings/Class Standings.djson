\u0027\r\n\t\tif (ir == \u0027--\u0027)\r\n\t\t\trating += \u0027--\u0027\r\n\t\telse\r\n\t\t\trating += sign + change\r\n\t}\r\n}\r\n\r\nreturn rating"},"Mode":2},"BackgroundColor":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const c = String((function(){\r\nconst classIdx = $prop(\u0027variable.ClassIdx\u0027);\r\nconst rowIdx = repeatindex() - 1;\r\nreturn getLicenseColor(classIdx, rowIdx);\r\n})() || \u0027\u0027);\r\nreturn c.length \u003e= 7 ? \u0027#29\u0027 + c.replace(\u0027#\u0027, \u0027\u0027).slice(-6) : \u0027Transparent\u0027;"},"Mode":2},"TextColor":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const classIdx = $prop(\u0027variable.ClassIdx\u0027);\r\nconst rowIdx = repeatindex() - 1;\r\nreturn getLicenseTextColor(classIdx, rowIdx);"},"Mode":2},"Left":{"Formula":{"Expression":"(212 + [variable.variableWidth] + [variable.PositionChangeOffset]) + 20"},"Mode":2},"Width":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"return (function(){\r\nreturn 90 + $prop(\u0027variable.RatingOffset\u0027)\r\n})() + 12"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Inter","FontWeight":"SemiBold","FontSize":14.0,"Text":"Driver Name","TextColor":"#FFF2F2F3","HorizontalAlignment":0,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":127.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":100.0,"Name":"Driver Name","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const classIdx = $prop(\u0027variable.ClassIdx\u0027);\r\nconst rowIdx = repeatindex() - 1;\r\nreturn isnull(getStandingsProp(classIdx, rowIdx, \u0027Name\u0027), \"\");"},"Mode":2},"TextColor":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const classIdx = $prop(\u0027variable.ClassIdx\u0027)\r\nconst rowIdx = repeatindex() - 1\r\n\r\nif (!getStandingsProp(classIdx, rowIdx, \u0027IsHighlighted\u0027))\r\n\tretur