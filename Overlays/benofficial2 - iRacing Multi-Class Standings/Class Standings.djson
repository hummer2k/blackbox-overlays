{"Variables":{"DashboardVariables":[{"VariableName":"dashboardWidth","EvaluateOnlyOnce":true,"OverrideWithParentDashboardVariableWhenAvailable":false,"ValueExpression":{"Expression":"736"},"EvaluateBeforeScreenRoles":false},{"VariableName":"ClassIdx","EvaluateOnlyOnce":true,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"Expression":"0"},"EvaluateBeforeScreenRoles":false},{"VariableName":"PlayerNameTextColor","EvaluateOnlyOnce":true,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"Expression":"\u0027#FFCC00\u0027"},"EvaluateBeforeScreenRoles":false},{"VariableName":"PositionChangeOffset","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"Expression":"if([benofficial2.Standings.PositionChangeVisible] \u0026\u0026 [benofficial2.Session.Race],0,-25)"},"EvaluateBeforeScreenRoles":false},{"VariableName":"GapOffset","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"Expression":"if([benofficial2.Standings.GapVisible],0,-37)"},"EvaluateBeforeScreenRoles":false},{"VariableName":"IntervalOffset","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"Expression":"if([benofficial2.Standings.IntervalVisible],0,-37)"},"EvaluateBeforeScreenRoles":false},{"VariableName":"BestOffset","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"Expression":"if([benofficial2.Standings.BestVisible],0,-74)"},"EvaluateBeforeScreenRoles":false},{"VariableName":"LastOffset","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"Expression":"if([benofficial2.Standings.LastVisible],0,-74)"},"EvaluateBeforeScreenRoles":false},{"VariableName":"CountryVisible","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"Expression":"if([benofficial2.Session.TeamRacing],false,[benofficial2.Standings.CountryFlagVisible])"},"EvaluateBeforeScreenRoles":false},{"VariableName":"CountryOffset","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"Expression":"if([variable.CountryVisible],0,-20)"},"EvaluateBeforeScreenRoles":false},{"VariableName":"RatingOffset","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"let offset = 0\r\n\r\nif (!isnull($prop(\u0027benofficial2.Standings.SafetyRatingVisible\u0027), false))\r\n\toffset -= 32\r\n\r\nif (!isnull($prop(\u0027benofficial2.Standings.IRatingVisible\u0027), false))\r\n{\r\n\toffset -= 58\r\n}\r\nelse\r\n{\r\n\tconst isRace = isnull($prop(\u0027benofficial2.Session.Race\u0027), false)\r\n\tif (!isRace || !isnull($prop(\u0027benofficial2.Standings.IRatingChangeVisible\u0027), false))\r\n\t\toffset -= 25\r\n}\r\n\r\nreturn offset \u003c= -90 ? offset - 12 : offset"},"EvaluateBeforeScreenRoles":false},{"VariableName":"DeltaOffset","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"Expression":"if([benofficial2.Standings.DeltaVisible],0,-31)"},"EvaluateBeforeScreenRoles":false},{"VariableName":"PitTimeOffset","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"Expression":"if([benofficial2.Standings.PitDurationVisible],0,-45)"},"EvaluateBeforeScreenRoles":false},{"VariableName":"variableWidth","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":false,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"let variableWidthMax = $prop(\u0027variable.dashboardWidth\u0027) - 687\r\nvariableWidthMax -= $prop(\u0027variable.GapOffset\u0027)\r\nvariableWidthMax -= $prop(\u0027variable.IntervalOffset\u0027)\r\nvariableWidthMax -= $prop(\u0027variable.BestOffset\u0027)\r\nvariableWidthMax -= $prop(\u0027variable.LastOffset\u0027)\r\nvariableWidthMax -= $prop(\u0027variable.RatingOffset\u0027)\r\nvariableWidthMax -= $prop(\u0027variable.DeltaOffset\u0027)\r\nvariableWidthMax -= $prop(\u0027variable.PositionChangeOffset\u0027)\r\nvariableWidthMax -= $prop(\u0027variable.PitTimeOffset\u0027)\r\n\r\nconst desiredWidth = isnull($prop(\u0027benofficial2.Standings.Width\u0027), 730) + 46\r\nconst maxWidth = $prop(\u0027variable.dashboardWidth\u0027)\r\nconst minWidth = maxWidth - variableWidthMax\r\nreturn Math.min(variableWidthMax, Math.max(0, desiredWidth - minWidth))"},"EvaluateBeforeScreenRoles":false},{"VariableName":"headerWidth","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":false,"ValueExpression":{"Expression":"687 + [variable.variableWidth] + [variable.PositionChangeOffset] + [variable.RatingOffset] + [variable.GapOffset] + [variable.IntervalOffset] + [variable.BestOffset] + [variable.LastOffset] + [variable.DeltaOffset] + [variable.PitTimeOffset]"},"EvaluateBeforeScreenRoles":false},{"VariableName":"ClassNameWidth","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":1,"Interpreter":1,"Expression":"const defaultWidth = 100;\r\nconst classIdx = $prop(\u0027variable.ClassIdx\u0027);\r\nconst textSize = isnull(getStandingsClassProp(classIdx, \u0027NameSize\u0027), 0);\r\n\r\nif (textSize \u003c= 0) \r\n\treturn defaultWidth;\r\n\r\n// textSize is in pixel, convert to desired size in SimHub units\r\nconst width = textSize * 0.62 + 10\r\nconst ratingWidth = 90 + $prop(\u0027variable.RatingOffset\u0027)\r\nconst maxWidth = 100 + $prop(\u0027variable.variableWidth\u0027) + ratingWidth\r\nreturn Math.min(width, maxWidth)"},"EvaluateBeforeScreenRoles":false},{"VariableName":"deltaStyle","EvaluateOnlyOnce":true,"OverrideWithParentDashboardVariableWhenAvailable":false,"ValueExpression":{"Expression":"2"},"EvaluateBeforeScreenRoles":false},{"VariableName":"classColor","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhen