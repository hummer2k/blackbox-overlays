DryTireCompounds)\r\n        image = \u0027Tire Hard.png\u0027\r\n    else\r\n        image = \u0027Tire Dry.png\u0027\r\n    break;\r\n  case \u0027S\u0027:\r\n    image = \u0027Tire Soft.png\u0027\r\n    break;\r\n  case \u0027M\u0027:\r\n    image = \u0027Tire Medium.png\u0027\r\n    break;\r\n  case \u0027W\u0027:\r\n    image = \u0027Tire Wet iRacing.png\u0027\r\n    break;\r\n  case \u0027I\u0027:\r\n    image = \u0027Tire Intermediate.png\u0027\r\n    break;\r\n  case \u0027A\u0027:\r\n    image = \u0027Tire AllPurpose.png\u0027\r\n    break;\r\n  default:\r\n    image = \u0027Tire Dry.png\u0027\r\n}\r\n\r\nreturn \u0027library:benofficial2\\\\Icons\\\\\u0027 + image"},"Mode":2}}}],"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":592.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":18.0,"Name":"Tire Compound","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const classIdx = $prop(\u0027variable.ClassIdx\u0027)\r\nconst rowIdx = repeatindex() - 1\r\nreturn getTireCompoundVisible(classIdx, rowIdx)"},"Mode":2},"Left":{"Formula":{"Expression":"(((546 + [variable.variableWidth] + [variable.PositionChangeOffset] + [variable.RatingOffset] + [variable.GapOffset] + [variable.IntervalOffset] + [variable.BestOffset] + [variable.LastOffset] + [variable.DeltaOffset]) + 20) + 12) + 14"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Roboto Mono","FontWeight":"Bold","FontSize":13.0,"Text":"+8.8","TextColor":"#FFF2F2F3","HorizontalAlignment":1,"VerticalAlignment":1,"UseMonospacedText":false,"CharWidth":8.0,"SpecialCharsWidth":4.0,"BackgroundColor":"#73FF6345","Height":20.0,"Left":557.0,"Top":2.0,"Visible":true,"BlinkPhasisInverted":false,"Width":34.0,"Name":"Delta Lap Time","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const classIdx = $prop(\u0027variable.ClassIdx\u0027);\r\nconst rowIdx = repeatindex() - 1\r\n\r\nconst useDeltaToPlayer = $prop(\u0027benofficial2.Standings.UseDeltaToPlayer\u0027)\r\n\r\nlet delta = null\r\nif (useDeltaToPlayer)\r\n\tdelta = getStandingsProp(classIdx, rowIdx, \u0027DeltaToPlayer\u0027)\r\nelse\r\n\tdelta = getStandingsProp(classIdx, rowIdx, \u0027DeltaToClassLeader\u0027)\r\n\r\nif (delta == null)\r\n\treturn \u0027--\u0027\r\n\t\r\nlet secs = timespantoseconds(delta)\r\nconst decimals = Math.abs(secs) \u003e= 10 ? 0 : 1\r\nconst sign = secs == 0 ? false : true\r\n\r\nif (secs \u003e= 60)\r\n\tsecs = 59\r\nelse if (secs \u003c= -60)\r\n\tsecs = -59\r\n\r\nreturn toshorttime(secondstotimespan(secs), decimals, sign, false)"},"Mode":2},"TextColor":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const classIdx = $prop(\u0027variable.ClassIdx\u0027)\r\nconst rowIdx = repeatindex() - 1\r\n\r\nif ($prop(\u0027variable.deltaStyle\u0027) == 1)\r\n{\r\n\tconst useDeltaToPlayer = $prop(\u0027benofficial2.Standings.UseDeltaToPlayer\u0027)\r\n\t\r\n\tlet delta = null\r\n\tif (useDeltaToPlayer)\r\n\t\tdelta = getStandingsProp(classIdx, rowIdx, \u0027DeltaToPlayer\u0027)\r\n\telse\r\n\t\tdelta = getStandingsProp(classIdx, rowIdx, \u0027DeltaToClassLeader\u0027)\r\n\t\t\r\n\tif (delta == null)\r\n\t\treturn \u0027#F2F2F3\u0027\r\n\t\t\r\n\tlet secs = timespantoseconds(delta)\r\n\tif (secs \u003e 0)\r\n\t\treturn \u0027#FFFF6345\u0027 // Red\r\n\telse\r\n\t\treturn \u0027#FF52E052\u0027 // Green\r\n}\r\n\r\nif (!getStandingsProp(classIdx, rowIdx, \u0027IsHighlighted\u0027))\r\n\treturn \u0027#F2F2F3\u0027\r\n\r\nreturn $prop(\u0027variable.PlayerNameTextColor\u0027)"},"Mode":2},"Visible":{"Formula":{"Expression":"[benofficial2.Standings.DeltaVisible]"},"Mode":2},"Left":{"Formula":{"Expression":"(((511 + [variable.variableWidth] + [variable.PositionChangeOffset] + [variable.RatingOffset] + [variable.GapOffset] + [variable.IntervalOffset] + [variable.BestOffset] + [variable.LastOffset]) + 20) + 12) + 14"},"Mode":2},"BackgroundColor":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"if ($prop(\u0027variable.deltaStyle\u0027) == 1)\r\n\treturn \u0027Transparent\u0027\r\n\r\nconst classIdx = $prop(\u0027variable.ClassIdx\u0027);\r\nconst rowIdx = repeatindex() - 1\r\n\r\nconst useDeltaToPlayer = $prop(\u0027benofficial2.Standings.UseDeltaToPlayer\u0027)\r\n\r\nlet delta = null\r\nif (useDeltaToPlayer)\r\n\tdelta = getStandingsProp(classIdx, rowIdx, \u0027DeltaToPlayer\u0027)\r\nelse\r\n\tdelta = getStandingsProp(classIdx, rowIdx, \u0027DeltaToClassLeader\u0027)\r\n\r\nif (delta == null)\r\n\treturn \u0027Transparent\u0027\r\n\t\r\nlet secs = timespantoseconds(delta)\r\nif (secs \u003e 0)\r\n\treturn \u0027#73FF6345\u0027 // Red\r\nelse\r\n\treturn \u0027#7352E052\u0027 // Green"},"Mode":2}},"BorderStyle":{"RadiusTopLeft":4,"RadiusTopRight":4,"RadiusBottomLeft":4,"RadiusBottomRight":4}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Roboto Mono","FontWeight":"Bold","FontSize":13.0,"Text":"12:34.897","TextColor":"#FFF2F2F3","HorizontalAlignment":1,"VerticalAlignment":1,"UseMonospacedText":false,"CharWidth":8.0,"SpecialCharsWidth":4.0,"BackgroundColor":"#7352E052","Height":20.0,"Left":485.0,"Top":2.0,"Visible":true,"BlinkPhasisInverted":false,"Width":72.0,"Name":"Last Lap Time","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const classIdx = $prop(\u0027variable.ClassIdx\u0027);\r\nconst rowIdx = repeatindex() - 1\r\n\r\nconst visible = getLapTimingVisible(classIdx, rowIdx)\r\n\r\nconst time = getStandingsProp(classIdx, rowIdx, \u0027LastLapTime\u0027)\r\nif (isInvalidTime(time) || !visible)\r\n\treturn \u0027-:--.---\u0027\r\n\r\nreturn toshorttime(time, 3, false, true)"},"Mode":2},"TextColor":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const classIdx = $prop(\u0027variable.ClassIdx\u0027)\r\nconst rowIdx = repeatindex() - 1\r\n\r\nif (!getStandingsProp(classIdx, rowIdx, \u0027IsHighlighted\u0027))\r\n\treturn \u0027#F2F2F3\u0027\r\n\t\r\nreturn $prop(\u0027variable.PlayerNameTextColor\u0027)"},"Mode":2},"Visible":{"Formula":{"Expression":"[benofficial2.Standings.LastVisible]"},"Mode":2},"Left":{"Formula":{"Expression":"(((446 + [variable.variableWidth] + [variable.PositionChangeOffset] + [variable.RatingOffset] + [variable.GapOffset] + [variable.IntervalOffset] + [variable.BestOffset]) + 20) + 12) + 7"},"Mode":2},"BackgroundColor":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const color = \u0027Transparent\u0027;\r\nconst classIdx = $prop(\u0027variable.ClassIdx\u0027);\r\nconst rowIdx = repeatindex() - 1;\r\n\r\nif (!getLapTimingVisible(classIdx, rowIdx))\r\n\treturn color;\r\n\r\nconst lastTime = getStandingsProp(classIdx, rowIdx, \u0027LastLapTime\u0027);\r\nif (isInvalidTime(lastTime)) \r\n\treturn color;\r\n\r\nconst classBestTime = getStandingsClassProp(classIdx, \u0027BestLapTime\u0027);\r\nif (isInvalidTime(classBestTime)) \r\n\treturn color;\r\n\r\nconst bestTime = getStandingsProp(classIdx, rowIdx, \u0027BestLapTime\u0027);\r\nif (isInvalidTime(bestTime)) \r\n\treturn color;\r\n\r\nif (timespantoseconds(lastTime) == timespantoseconds(classBestTime))\r\n\treturn \u0027#73FF00FF\u0027 // Purple\r\n\r\nif (timespantoseconds(lastTime) == timespantoseconds(bestTime))\r\n\treturn \u0027#7352E052\u0027 // Green\r\n\r\nreturn color;"},"Mode":2}},"BorderStyle":{"RadiusTopLeft":4,"RadiusTopRight":4,"RadiusBottomLeft":4,"RadiusBottomRight":4}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Roboto Mono","FontWeight":"Bold","FontSize":13.0,"Text":"12:34.897","TextColor":"#FFF2F2F3","HorizontalAlignment":1,"VerticalAlignment":1,"UseMonospacedText":false,"CharWidth":8.0,"SpecialCharsWidth":4.0,"BackgroundColor":"#00FFFFFF","Height":20.0,"Left":411.0,"Top":2.0,"Visible":true,"BlinkPhasisInverted":false,"Width":72.0,"Name":"Best Lap Time","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const classIdx = $prop(\u0027variable.ClassIdx\u0027)\r\nconst rowIdx = repeatindex() - 1\r\n\r\nconst visible = getLapTimingVisible(classIdx, rowIdx)\r\n\r\nconst time = getStandingsProp(classIdx, rowIdx, \u0027BestLapTime\u0027)\r\nif (isInvalidTime(time) || !visible)\r\n\treturn \u0027-:--.---\u0027\r\n\r\nreturn toshorttime(time, 3, false, true)"},"Mode":2},"TextColor":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const classIdx = $prop(\u0027variable.ClassIdx\u0027)\r\nconst rowIdx = repeatindex() - 1\r\n\r\nif (!getStandingsProp(classIdx, rowIdx, \u0027IsHighlighted\u0027))\r\n\treturn \u0027#F2F2F3\u0027\r\n\t\r\nreturn $prop(\u0027variable.PlayerNameTextColor\u0027)"},"Mode":2},"Visible":{"Formula":{"Expression":"[benofficial2.Standings.BestVisible]"},"Mode":2},"Left":{"Formula":{"Expression":"((379 + [variable.variableWidth] + [variable.PositionChangeOffset] + [variable.RatingOffset] + [variable.GapOffset] + [variable.IntervalOffset]) + 20) + 12"},"Mode":2},"BackgroundColor":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const color = \u0027Transparent\u0027;\r\nconst classIdx = $prop(\u0027variable.ClassIdx\u0027);\r\nconst rowIdx = repeatindex() - 1;\r\n\r\nif (!getLapTimingVisible(classIdx, rowIdx))\r\n\treturn color\r\n\r\nconst classBestTime = getStandingsClassProp(classIdx, \u0027BestLapTime\u0027);\r\nif (isInvalidTime(classBestTime)) \r\n\treturn color;\r\n\r\nconst bestTime = getStandingsProp(classIdx, rowIdx, \u0027BestLapTime\u0027);\r\nif (isInvalidTime(bestTime)) \r\n\treturn color;\r\n\r\nif (timespantoseconds(bestTime) == timespantoseconds(classBestTime))\r\n\treturn \u0027#73FF00FF\u0027 // Purple\r\n\r\nreturn color;"},"Mode":2}},"BorderStyle":{"RadiusTopLeft":4,"RadiusTopRight":4,"RadiusBottomLeft":4,"RadiusBottomRight":4}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Roboto Mono","FontWeight":"Bold","FontSize":13.0,"Text":"59.8","TextColor":"#FFF2F2F3","HorizontalAlignment":1,"VerticalAlignment":1,"UseMonospacedText":false,"CharWidth":8.0,"SpecialCharsWidth":4.0,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":374.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":36.0,"Name":"Interval","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const classIdx = $prop(\u0027variable.ClassIdx\u0027);\r\nconst rowIdx = repeatindex() - 1;\r\n\r\nconst lap = isnull(getStandingsProp(classIdx, rowIdx, \u0027CurrentLap\u0027), 0);\r\nif (lap == 0) \r\n\treturn \u0027--\u0027\r\n\r\nif (rowIdx == 0)\r\n\treturn \u0027L\u0027 + lap;\r\n\r\nconst lapsBehind = isnull(getStandingsProp(classIdx, rowIdx, \u0027LapsToClassOpponentAhead\u0027), 0);\r\nif (lapsBehind \u003e 0)\r\n\treturn String(lapsBehind) + \u0027L\u0027;\r\n\r\nconst gap = isnull(getStandingsProp(classIdx, rowIdx, \u0027GapToClassOpponentAhead\u0027), 0);\r\nif (gap \u003c= 0.0)\r\n\treturn \u0027--\u0027\r\n\r\nif (gap \u003e= 60.0)\r\n\treturn toshorttime(secondstotimespan(gap), 0, 0, 1)\r\n\t\r\nreturn Math.abs(gap).toFixed(1);"},"Mode":2},"TextColor":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const classIdx = $prop(\u0027variable.ClassIdx\u0027)\r\nconst rowIdx = repeatindex() - 1\r\n\r\nif (!getStandingsProp(classIdx, rowIdx, \u0027IsHighlighted\u0027))\r\n\treturn \u0027#F2F2F3\u0027\r\n\t\r\nreturn $prop(\u0027variable.PlayerNameTextColor\u0027)"},"Mode":2},"Visible":{"Formula":{"Expression":"[benofficial2.Standings.IntervalVisible]"},"Mode":2},"Left":{"Formula":{"Expression":"((342 + [variable.variableWidth] + [variable.PositionChangeOffset] + [variable.RatingOffset] + [variable.GapOffset]) + 20) + 12"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Fon