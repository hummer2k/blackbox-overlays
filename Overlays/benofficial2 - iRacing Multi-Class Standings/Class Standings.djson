027LastPitDuration\u0027)\r\n\t\r\nif (isInvalidTime(time))\r\n\treturn \u0027-:--\u0027\r\n\r\nreturn toshorttime(time, 0, false, true)"},"Mode":2},"TextColor":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const classIdx = $prop(\u0027variable.ClassIdx\u0027)\r\nconst rowIdx = repeatindex() - 1\r\n\r\nif (!getStandingsProp(classIdx, rowIdx, \u0027IsHighlighted\u0027))\r\n\treturn \u0027#F2F2F3\u0027\r\n\t\r\nreturn $prop(\u0027variable.PlayerNameTextColor\u0027)"},"Mode":2},"Visible":{"Formula":{"Expression":"[benofficial2.Standings.PitDurationVisible]"},"Mode":2},"Left":{"Formula":{"Expression":"(((596 + [variable.variableWidth] + [variable.PositionChangeOffset] + [variable.RatingOffset] + [variable.GapOffset] + [variable.IntervalOffset] + [variable.BestOffset] + [variable.LastOffset] + [variable.DeltaOffset]) + 20) + 12) + 14"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.GroupItem, SimHub.Plugins","ChildsPositioning":0,"ChildsPositioningAlignment":0,"GroupPadding":{},"ChildsMargin":{},"ChildAlignmentHorizontal":0,"ChildAlignmentVertical":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Inter","FontWeight":"SemiBold","FontSize":14.0,"Text":"L500","TextColor":"#FFFFD100","HorizontalAlignment":1,"VerticalAlignment":1,"UseMonospacedText":true,"CharWidth":8.0,"SpecialCharsWidth":3.0,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":0.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":31.0,"Name":"Pit Lap","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const isRace = $prop(\u0027benofficial2.Session.Race\u0027)\r\nif (isRace \u0026\u0026 !isRaceStarted())\t\r\n\treturn \u0027\u0027\r\n\r\nconst classIdx = $prop(\u0027variable.ClassIdx\u0027);\r\nconst rowIdx = repeatindex() - 1;\r\n\r\n//const tireCompoundVisible = getTireCompoundVisible(classIdx, rowIdx);\r\n//if (!tireCompoundVisible) \r\n//\treturn \u0027\u0027\r\n\r\nconst inPitLane = isnull(getStandingsProp(classIdx, rowIdx, \u0027InPitLane\u0027), false);\r\nif (inPitLane) \r\n\treturn \u0027\u0027\r\n\r\nconst showStintLapInRace = isnull($prop(\u0027benofficial2.Standings.ShowStintLapInRace\u0027), true)\r\nconst showStint = !isRace || showStintLapInRace\r\nif (!showStint)\r\n{\r\n\tconst enterPitLap = isnull(getStandingsProp(classIdx, rowIdx, \u0027EnterPitLap\u0027), -1);\r\n\tif (enterPitLap \u003c= 0) \r\n\t\treturn \u0027\u0027\r\n\t\t\r\n\treturn \u0027L\u0027 + enterPitLap;\r\n}\r\n\r\nconst stintLap = isnull(getStandingsProp(classIdx, rowIdx, \u0027StintLap\u0027), 0);\r\nif (stintLap \u003c= 0) \r\n\treturn \u0027--\u0027\r\n\t\r\nreturn \u0027L\u0027 + stintLap"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Inter","FontWeight":"SemiBold","FontSize":14.0,"Text":"PIT","TextColor":"#FF000000","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#BEFFD100","Height":20.0,"Left":0.0,"Top":2.0,"Visible":true,"BlinkPhasisInverted":false,"Width":31.0,"Name":"Pit","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const classIdx = $prop(\u0027variable.ClassIdx\u0027);\r\nconst rowIdx = repeatindex() - 1;\r\nconst towing = isnull(getStandingsProp(classIdx, rowIdx, \u0027Towing\u0027), false);\r\nconst inPitLane = isnull(getStandingsProp(classIdx, rowIdx, \u0027InPitLane\u0027), false);\r\nreturn inPitLane \u0026\u0026 !towing;"},"Mode":2}},"BorderStyle":{"RadiusTopLeft":4,"RadiusTopRight":4,"RadiusBottomLeft":4,"RadiusBottomRight":4}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Inter","FontWeight":"SemiBold","FontSize":13.0,"Text":"TOW","TextColor":"#FF000000","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#BEFF6345","Height":20.0,"Lef