"BorderStyle":{"RadiusBottomLeft":7,"RadiusBottomRight":7},"Opacity":2.066,"Height":100.0,"Left":1.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":442.0,"Name":"Panel Shade 46","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Width":{"Formula":{"Expression":"[variable.rowWidth] - 2"},"Mode":2},"Top":{"Formula":{"Expression":"[variable.panelHeight] * 46 / 49"},"Mode":2},"Height":{"Formula":{"Expression":"[variable.panelHeight] * (49 - 46) / 49 - 1"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins","IsRectangleItem":true,"BackgroundColor":"#FF00000C","BorderStyle":{"RadiusBottomLeft":7,"RadiusBottomRight":7},"Opacity":2.109,"Height":100.0,"Left":1.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":442.0,"Name":"Panel Shade 47","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Width":{"Formula":{"Expression":"[variable.rowWidth] - 2"},"Mode":2},"Top":{"Formula":{"Expression":"[variable.panelHeight] * 47 / 49"},"Mode":2},"Height":{"Formula":{"Expression":"[variable.panelHeight] * (49 - 47) / 49 - 1"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins","IsRectangleItem":true,"BackgroundColor":"#FF00000C","BorderStyle":{"RadiusBottomLeft":7,"RadiusBottomRight":7},"Opacity":2.155,"Height":100.0,"Left":1.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":442.0,"Name":"Panel Shade 48","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Width":{"Formula":{"Expression":"[variable.rowWidth] - 2"},"Mode":2},"Top":{"Formula":{"Expression":"[variable.panelHeight] * 48 / 49"},"Mode":2},"Height":{"Formula":{"Expression":"[variable.panelHeight] * (49 - 48) / 49 - 1"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","Group":false,"Repetitions":3,"PrepareRepetitions":true,"RepeatTopOffset":0.0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.WidgetItem, SimHub.Plugins","Variables":{"DashboardVariables":[{"VariableName":"ClassIdx","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"return repeatindex() - 1;"},"EvaluateBeforeScreenRoles":false}]},"NextScreenCommand":0,"PreviousScreenCommand":0,"AutoSize":true,"FileName":"Class Standings.djson","InitialScreenIndex":0,"FreezePageChanges":false,"EnableScreenRolesAndActivation":true,"IgnoreSavedScreensEx":true,"BackgroundColor":"#00FFFFFF","Height":529.0,"Left":0.0,"Top":30.0,"Visible":true,"BlinkPhasisInverted":false,"Width":764.0,"Name":"Class Standings","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const visibleClassCount = isnull($prop(\u0027benofficial2.Standings.VisibleClassCount\u0027), 0);\r\nconst classIdx = repeatindex() - 1;\r\nconst visibleRowCount = isnull(getStandingsClassProp(classIdx, \u0027VisibleRowCount\u0027), 0);\r\nreturn classIdx \u003c visibleClassCount \u0026\u0026 visibleRowCount \u003e 0;"},"Mode":2},"Top":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const titleVisible = isnull($prop(\u0027benofficial2.Standings.HeaderVisible\u0027), true);\nconst classHeaderVisible = isnull($prop(\u0027benofficial2.Standings.CarClassHeaderVisible\u0027), true);\nlet offset = titleVisible ? 32 : 6;\nfor (let i = 0; i \u003c repeatindex() - 1; i++)\n{\n\tconst visibleRowCount = isnull(getStandingsClassProp(i, \u0027VisibleRowCount\u0027), 0);\n\tif (visibleRowCount \u003e 0)\n\t{\n\t\toffset += 4 + visibleRowCount * 24;\n\t\tif (isDividerVisible(i)) offset += 3;\n\t\tif (classHeaderVisible) offset += 24;\n\t}\n}return offset;"},"Mode":2}}}],"Visible":true,"BlinkPhasisInverted":false,"Name":"Class Standings Repeat","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.GroupItem, SimHub.Plugins","ChildsPositioning":0,"ChildsPositioningAlignment":0,"GroupPadding":{},"ChildsMargin":{},"ChildAlignmentHorizontal":0,"ChildAlignmentVertical":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Inter","FontWeight":"Bold","FontSize":15.0,"Text":"STANDINGS","TextColor":"#FFFFCC00","HorizontalAlignment":0,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":9.0,"Top":4.0,"Visible":true,"BlinkPhasisInverted":false,"Width":200.0,"Name":"Title","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{}}],"BackgroundColor":"#00FFFFFF","Height":32.0,"Left":0.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":363.0,"Name":"Header","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"Expression":"[benofficial2.Standings.HeaderVisible]"},"Mode":2},"Width":{"Formula":{"Expression":"[variable.rowWidth]"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.GroupItem, SimHub.Plugins","ChildsPositioning":0,"ChildsPositioningAlignment":0,"GroupPadding":{},"ChildsMargin":{},"ChildAlignmentHorizontal":0,"ChildAlignmentVertical":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins","IsRectangleItem":true,"BackgroundColor":"#FFFFFFFF","BorderStyle":{"RadiusTopLeft":4,"RadiusTopRight":4,"RadiusBottomLeft":4,"RadiusBottomRight":4},"Opacity":4.0,"Height":24.0,"Left":0.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":100.0,"Name":"Lap Cell","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Left":{"Formula":{"Expression":"3 + 0 * ((([variable.rowWidth] - 6 - 4) / 2) + 4)"},"Mode":2},"Width":{"Formula":{"Expression":"(([variable.rowWidth] - 6 - 4) / 2)"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Inter","FontWeight":"SemiBold","FontSize":14.0,"Text":"Lap","TextColor":"#FFFFCC00","HorizontalAlignment":0,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":0.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":90.0,"Name":"Lap Label","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Left":{"Formula":{"Expression":"3 + 0 * ((([variable.rowWidth] - 6 - 4) / 2) + 4) + 12"},"Mode":2},"Width":{"Formula":{"Expression":"(([variable.rowWidth] - 6 - 4) / 2) - 20"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Roboto Mono","FontWeight":"Bold","FontSize":13.0,"Text":"","TextColor":"#FFF2F2F3","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":0.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":90.0,"Name":"Lap Value","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Left":{"Formula":{"Expression":"3 + 0 * ((([variable.rowWidth] - 6 - 4) / 2) + 4) + 12"},"Mode":2},"Width":{"Formula":{"Expression":"(([variable.rowWidth] - 6 - 4) / 2) - 20"},"Mode":2},"Text":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"let currentLap = 0\r\nif ($prop(\u0027benofficial2.Highlighted.CarIdx\u0027) \u003c 0)\r\n\tcurrentLap = $prop(\u0027benofficial2.Player.CurrentLap\u0027)\r\nelse\r\n\tcurrentLap = $prop(\u0027benofficial2.Highlighted.CurrentLap\u0027)\r\n\r\nconst sessionLapsTotal = $prop(\u0027benofficial2.Session.LapsTotal\u0027)\r\nconst playerClassIdx = $prop(\u0027benofficial2.Standings.PlayerCarClassIdx\u0027)\r\nconst estimatedTotalLaps = getStandingsClassProp(playerClassIdx, \u0027EstimatedTotalLaps\u0027)\r\n\r\nlet total = \u0027~\u0027\r\nif (sessionLapsTotal \u003e 0 \u0026\u0026 (estimatedTotalLaps \u003c= 0 || sessionLapsTotal \u003c= estimatedTotalLaps))\r\n{\r\n\ttotal = sessionLapsTotal\r\n}\r\nelse if (estimatedTotalLaps \u003e 0)\r\n{\r\n\ttotal = \u0027~\u0027 + estimatedTotalLaps\r\n}\r\n\r\nreturn \u0027\u0027 + currentLap + \u0027/\u0027 + total"},"Mode":2}},"UseMonospacedText":false},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins","IsRectangleItem":true,"BackgroundColor":"#FFFFFFFF","BorderStyle":{"RadiusTopLeft":4,"RadiusTopRight":4,"RadiusBottomLeft":4,"RadiusBottomRight":4},"Opacity":4.0,"Height":24.0,"Left":0.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":100.0,"Name":"Left Cell","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Left":{"Formula":{"Expression":"3 + 1 * ((([variable.rowWidth] - 6 - 4) / 2) + 4)"},"Mode":2},"Width":{"Formula":{"Expression":"(([variable.rowWidth] - 6 - 4) / 2)"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Inter","FontWeight":"SemiBold","FontSize":14.0,"Text":"Left","TextColor":"#FFFFCC00","HorizontalAlignment":0,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":0.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":90.0,"Name":"Left Label","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Left":{"Formula":{"Expression":"3 + 1 * ((([variable.rowWidth] - 6 - 4) / 2) + 4) + 12"},"Mode":2},"Width":{"Formula":{"Expression":"(([variable.rowWidth] - 6 - 4) / 2) - 20"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Roboto Mono","FontWeight":"Bold","FontSize":13.0,"Text":"","TextColor":"#FFF2F2F3","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":0.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":90.0,"Name":"Left Value","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Left":{"Formula":{"Expression":"3 + 1 * ((([variable.rowWidth] - 6 - 4) / 2) + 4) + 12"},"Mode":2},"Width":{"Formula":{"Expression":"(([variable.rowWidth] - 6 - 4) / 2) - 20"},"Mode":2},"Text":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const sessionTimeRemain = $prop(\u0027DataCorePlugin.GameRawData.Telemetry.SessionTimeRemain\u0027);\r\nreturn formatSecondsToTimecode(sessionTimeRemain);"},"Mode":2}},"UseMonospacedText":false}],"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":0.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":724.0,"Name":"Footer","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Top":{"Formula":{"Expression":"[variable.panelHeight] - 28"},"Mode":2},"Width":{"Formula":{"Expression":"[variable.rowWidth]"},"Mode":2}}}],"Visible":true,"BlinkPhasisInverted":false,"Name":"Visible","RenderingSkip":100,"MinimumRefreshIntervalMS":1000.0,"Bindings":{"Visible":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"if (!isnull($prop(\u0027benofficial2.iRacingRunning\u0027), false)) \r\n\treturn false\r\n\r\nconst hideInReplay = isnull($prop(\u0027benofficial2.Standings.HideInReplay\u0027), true)\r\nconst replayPlaying = isnull($prop(\u0027benofficial2.Session.ReplayPlaying\u0027), false)\r\n\r\nif (hideInReplay \u0026\u0026 replayPlaying) \r\n\treturn false\r\n\t\r\nif (isnull($prop(\u0027GameRawData.Telemetry.IsGarageVisible\u0027), false))\r\n\treturn false\r\n\r\nreturn true"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":12.0,"Text":"New version available","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#FFFF0000","BorderStyle":{"RadiusTopLeft":3,"RadiusTopRight":3,"RadiusBottomLeft":3,"RadiusBottomRight":3},"Height":18.0,"Left":89.0,"Top":5.0,"Visible":false,"BlinkPhasisInverted":false,"Width":205.0,"Name":"Version","RenderingSkip":50,"MinimumRefreshIntervalMS":500.0,"Bindings":{"Visible":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"return checkVersion(g_VersionName, g_VersionNumber) || getErrorMessage() != \u0027\u0027","PreExpression":"// Download new version at https://github.com/fixfactory/bo2-official-overlays\r\nconst g_VersionName = \u0027multiclassstandings\u0027\r\nconst g_VersionNumber = \u00275.2\u0027"},"Mode":2},"Text":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const errorMessage = getErrorMessage()\r\nreturn errorMessage != \u0027\u0027 ? errorMessage : \"New version available\""},"Mode":2}}}],"MinimumRefreshIntervalMS":0.0}],"SnapToGrid":false,"HideLabels":true,"ShowForeground":true,"ForegroundOpacity":100.0,"ShowBackground":true,"BackgroundOpacity":100.0,"ShowBoundingRectangles":false,"GridSize":10,"Images":[],"Metadata":{"SettingsBuilder":{"Settings":[],"IsEditMode":false},"ScreenCount":1.0,"InGameScreensIndexs":[0],"IdleScreensIndexs":[0],"MainPreviewIndex":0,"IsOverlay":true,"OverlaySizeWarning":false,"MetadataVersion":2.0,"EnableOnDashboardMessaging":true,"PitScreensIndexs":[],"PreferredTouchMode":0,"SimHubVersion":"9.12.8","Author":"twitch.tv/benofficial2","Width":724.0,"Height":846.0,"DashboardVersion":""},"ShowOnScreenControls":true,"IsOverlay":true,"EnableClickThroughOverlay":true,"EnableOnDashboardMessaging":true,"UseStrictJSIsolation":false,"UseStrictJSIsolationWarning":true}