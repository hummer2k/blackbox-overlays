adiusTopRight":2,"RadiusBottomLeft":2,"RadiusBottomRight":2,"Bindings":{"BorderColor":{"Formula":{"Expression":"[variable.classColor]"},"Mode":2}}},"Opacity":100.0,"Height":10.0,"Left":32.0,"Top":7.0,"Visible":true,"BlinkPhasisInverted":false,"Width":10.0,"Name":"Marker Square","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"return getRelativeProp($prop(\u0027variable.relativeIdx\u0027), \u0027CarClassColor\u0027) == getRelativeProp(0, \u0027CarClassColor\u0027)"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins","IsRectangleItem":true,"BackgroundColor":"#FF1E1E24","BorderStyle":{"BorderColor":"#FFFFFFFF","BorderTop":2,"BorderBottom":2,"BorderLeft":2,"BorderRight":2,"RadiusTopLeft":5,"RadiusTopRight":5,"RadiusBottomLeft":5,"RadiusBottomRight":5,"Bindings":{"BorderColor":{"Formula":{"Expression":"[variable.classColor]"},"Mode":2}}},"Opacity":100.0,"Height":10.0,"Left":32.0,"Top":7.0,"Visible":true,"BlinkPhasisInverted":false,"Width":10.0,"Name":"Marker Circle","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"return !(getRelativeProp($prop(\u0027variable.relativeIdx\u0027), \u0027CarClassColor\u0027) == getRelativeProp(0, \u0027CarClassColor\u0027))"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Roboto Mono","FontWeight":"Bold","FontSize":13.0,"Text":"259.6","TextColor":"#FFF2F2F3","HorizontalAlignment":2,"VerticalAlignment":1,"UseMonospacedText":false,"CharWidth":8.0,"SpecialCharsWidth":3.0,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":466.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":35.0,"Name":"GapToPlayer","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"FormatString":"0.0","Formula":{"JSExt":1,"Interpreter":1,"Expression":"const index = $prop(\u0027variable.relativeIdx\u0027)\r\nif (index == 0)\r\n    return \u0027\u0027\r\n\r\nconst gap = Math.abs(getRelativeProp(index, \u0027GapToPlayer\u0027))\r\n\r\nif (gap \u003e= 60.0)\r\n\treturn toshorttime(secondstotimespan(gap), 0, 0, 1)\r\n\t\r\nreturn gap.toFixed(1)"},"Mode":2},"TextColor":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const index = $prop(\u0027variable.relativeIdx\u0027);\r\nreturn getRelativeTextColor(index);"},"Mode":2},"Left":{"Formula":{"Expression":"((((401 + [variable.variableWidth] + [variable.RatingOffset] + [variable.LastLapTimeOffset] + [variable.TireCompoundOffset] + [variable.StintLapOffset]) + 21) + 28) + 12) + 4"},"Mode":2},"Width":{"Formula":{"Expression":"[variable.headerWidth] - 1 - (((((401 + [variable.variableWidth] + [variable.RatingOffset] + [variable.LastLapTimeOffset] + [variable.TireCompoundOffset] + [variable.StintLapOffset]) + 21) + 28) + 12) + 4)"},"Mode":2}},"TextPadding":{"PaddingRight":6}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.GroupItem, SimHub.Plugins","ChildsPositioning":0,"ChildsPositioningAlignment":0,"GroupPadding":{},"ChildsMargin":{},"ChildAlignmentHorizontal":0,"ChildAlignmentVertical":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Inter","FontWeight":"SemiBold","FontSize":14.0,"Text":"L500","TextColor":"#FFFFD100","HorizontalAlignment":1,"VerticalAlignment":1,"UseMonospacedText":true,"CharWidth":8.0,"SpecialCharsWidth":3.0,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":0.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":31.0,"Name":"Pit Lap","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const isRace = $prop(\u0027Blackbox.Session.Race\u0027)\r\nif (isRace \u0026\u0026 !isRaceStarted())\t\r\n\treturn \u0027\u0027\r\n\r\nconst index = $prop(\u0027variable.relativeIdx\u0027)\r\n\r\n//const tireCompoundVisible = getTireCompoundVisible(index);\r\n//if (!tireCompoundVisible) \r\n//\treturn \u0027\u0027\r\n\r\nconst inPitLane = isnull(getRelativeProp(index, \u0027InPit\u0027), false);\r\nif (inPitLane) \r\n\treturn \u0027\u0027\r\n\r\nconst showStintLapInRace = isnull($prop(\u0027Blackbox.Relative.ShowStintLapInRace\u0027), true)\r\nconst showStint = !isRace || showStintLapInRace\r\nif (!showStint)\r\n{\r\n\tconst enterPitLap = isnull(getRelativeProp(index, \u0027EnterPitLap\u0027), -1);\r\n\tif (enterPitLap \u003c= 0) \r\n\t\treturn \u0027\u0027\r\n\t\t\r\n\treturn \u0027L\u0027 + enterPitLap;\r\n}\r\n\r\nconst stintLap = isnull(getRelativeProp(index, \u0027StintLap\u0027), 0);\r\nif (stintLap \u003c= 0) \r\n\treturn \u0027--\u0027\r\n\r\nreturn \u0027L\u0027 + stintLap"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Inter","FontWeight":"SemiBold","FontSize":14.0,"Text":"PIT","TextColor":"#FF000000","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#BEFFD100","Height":20.0,"Left":0.0,"Top":2.0,"Visible":true,"BlinkPhasisInverted":false,"Width":31.0,"Name":"Pit","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const index = $prop(\u0027variable.relativeIdx\u0027)\r\nconst towing = isnull(getRelativeProp(index, \u0027Towing\u0027), false)\r\nconst inPitLane = isnull(getRelativeProp(index, \u0027InPit\u0027), false)\r\nreturn inPitLane \u0026\u0026 !towing;"},"Mode":2}},"BorderStyle":{"RadiusTopLeft":4,"RadiusTopRight":4,"RadiusBottomLeft":4,"RadiusBottomRight":4}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Inter","FontWeight":"SemiBold","FontSize":13.0,"Text":"TOW","TextColor":"#FF000000","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#BEFF6345","Height":20.0,"Left":0.0,"Top":2.0,"Visible":true,"BlinkPhasisInverted":false,"Width"