{"Variables":{"DashboardVariables":[{"VariableName":"spotterHeight","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"const spotterThreshold = isnull($prop(\u0027Blackbox.Spotter.Threshold\u0027), 5.5)\r\nconst spotterHeight = isnull($prop(\u0027Blackbox.Spotter.Height\u0027), 129)\r\nconst spotterMinHeight = isnull($prop(\u0027Blackbox.Spotter.MinHeight\u0027), 15)\r\nconst overlapAhead = isnull($prop(\u0027Blackbox.Spotter.OverlapAhead\u0027), 0)\r\nconst overlapBehind = isnull($prop(\u0027Blackbox.Spotter.OverlapBehind\u0027), 0)\r\nconst borderOffset = ($prop(\u0027variable.borderMax\u0027) - $prop(\u0027Blackbox.Spotter.Border\u0027)) * 2\r\n\r\nif (overlapAhead \u003c 0 \u0026\u0026 overlapBehind \u003e 0)\r\n\treturn spotterHeight + borderOffset\r\n\r\nif (overlapBehind \u003e 0)\r\n\treturn spotterHeight + borderOffset - (spotterHeight - spotterMinHeight) * overlapBehind / spotterThreshold\r\n\r\nif (overlapAhead \u003c 0)\r\n\treturn spotterHeight + borderOffset + (spotterHeight - spotterMinHeight) * overlapAhead / spotterThreshold\r\n\r\nreturn 0"},"EvaluateBeforeScreenRoles":false},{"VariableName":"spotterTop","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"const spotterThreshold = isnull($prop(\u0027Blackbox.Spotter.Threshold\u0027), 5.5)\r\nconst spotterBorder = isnull($prop(\u0027Blackbox.Spotter.Border\u0027), 3)\r\nconst spotterHeight = isnull($prop(\u0027Blackbox.Spotter.Height\u0027), 129)\r\nconst spotterMinHeight = isnull($prop(\u0027Blackbox.Spotter.MinHeight\u0027), 15)\r\nconst overlapAhead = isnull($prop(\u0027Blackbox.Spotter.OverlapAhead\u0027), 0)\r\nconst overlapBehind = isnull($prop(\u0027Blackbox.Spotter.OverlapBehind\u0027), 0)\r\n\r\nif (overlapAhead \u003c 0 \u0026\u0026 overlapBehind \u003e 0)\r\n\treturn spotterBorder\r\n\r\nif (overlapBehind \u003e 0)\r\n\treturn spotterBorder + (spotterHeight - spotterMinHeight) * overlapBehind / spotterThreshold\r\n\r\nreturn spotterBorder"},"EvaluateBeforeScreenRoles":false},{"VariableName":"spacingMax","EvaluateOnlyOnce":true,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"Expression":"500"},"EvaluateBeforeScreenRoles":false},{"VariableName":"spacing","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"const spacingPct = $prop(\u0027Blackbox.Spotter.Spacing\u0027)\r\nconst spacingMax = $prop(\u0027variable.spacingMax\u0027)\r\nreturn spacingMax * (spacingPct / 100) / 2"},"EvaluateBeforeScreenRoles":false},{"VariableName":"borderMax","EvaluateOnlyOnce":true,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"Expression":"3"},"EvaluateBeforeScreenRoles":false}]},"DashboardDebugManager":{"_dashSettingsStores":{},"WindowPositionSettings":{"IsFullScreen":false,"Position":"2629,326,695,135","TopMost":false,"AllowTransparency":true,"CloseOnMonitorLoss":false,"NoWindowActivate":false}},"Version":2,"Id":"1ffbba1c-6102-4587-83c7-3cbdb7733649","BaseHeight":135,"BaseWidth":712,"BackgroundColor":"#FF000000","Screens":[{"RenderingSkip":0,"Name":"Screen","InGameScreen":true,"IdleScreen":true,"PitScreen":false,"ScreenId":"5f8a5f7a-8785-4ca9-9d31-d42762f5ece3","AllowOverlays":true,"IsForegroundLayer":false,"IsOverlayLayer":false,"OverlayTriggerExpression":{"Expression":""},"ScreenEnabledExpression":{"Expression":""},"OverlayMaxDuration":0,"OverlayMinDuration":0,"IsBackgroundLayer":false,"BackgroundColor":"#00FFFFFF","Items":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","Group":false,"Repetitions":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","Group":true,"Repetitions":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","G