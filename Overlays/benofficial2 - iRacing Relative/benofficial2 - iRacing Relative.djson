rning) \u003e= 0\r\n\r\nif (warningValid \u0026\u0026 nextWarningValid)\r\n{\t\r\n\tlet nextLimit = Number(warning)\r\n\twhile (inc \u003e= nextLimit)\r\n\t\tnextLimit += Number(nextWarning)\r\n\t\t\r\n\tif (limitValid)\r\n\t\tlimitText = String(Math.min(limit, nextLimit))\r\n\telse\r\n\t\tlimitText = nextLimit\r\n}\r\n\r\nreturn Math.max(0, inc) + \u0027/\u0027 + limitText"},"Mode":2}},"UseMonospacedText":false},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins","IsRectangleItem":true,"BackgroundColor":"#FFFFFFFF","BorderStyle":{"RadiusTopLeft":4,"RadiusTopRight":4,"RadiusBottomLeft":4,"RadiusBottomRight":4},"Opacity":2.2,"Height":24.0,"Left":0.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":100.0,"Name":"SOF Cell","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Left":{"Formula":{"Expression":"3 + 1 * ((([variable.headerWidth] - 6 - 8) / 3) + 4)"},"Mode":2},"Width":{"Formula":{"Expression":"(([variable.headerWidth] - 6 - 8) / 3)"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Inter","FontWeight":"SemiBold","FontSize":14.0,"Text":"SOF","TextColor":"#FFFFCC00","HorizontalAlignment":0,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":0.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":90.0,"Name":"SOF Label","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Left":{"Formula":{"Expression":"3 + 1 * ((([variable.headerWidth] - 6 - 8) / 3) + 4) + 12"},"Mode":2},"Width":{"Formula":{"Expression":"(([variable.headerWidth] - 6 - 8) / 3) - 20"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Roboto Mono","FontWeight":"Bold","FontSize":13.0,"Text":"","TextColor":"#FFF2F2F3","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":0.0,"Top":0.0,"Visible":true,"BlinkPhasisIn