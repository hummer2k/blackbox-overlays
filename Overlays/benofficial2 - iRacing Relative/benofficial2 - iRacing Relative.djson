{"Variables":{"DashboardVariables":[{"VariableName":"dashboardWidth","EvaluateOnlyOnce":true,"OverrideWithParentDashboardVariableWhenAvailable":false,"ValueExpression":{"Expression":"575"},"EvaluateBeforeScreenRoles":false},{"VariableName":"RatingOffset","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"let offset = 0\r\n\r\nif (!isnull($prop(\u0027benofficial2.Relative.SafetyRatingVisible\u0027), false))\r\n\toffset -= 32\r\n\r\nif (!isnull($prop(\u0027benofficial2.Relative.IRatingVisible\u0027), false))\r\n{\r\n\toffset -= 58\r\n}\r\nelse\r\n{\r\n\tconst isRace = isnull($prop(\u0027benofficial2.Session.Race\u0027), false)\r\n\tif (!isRace || !isnull($prop(\u0027benofficial2.Relative.IRatingChangeVisible\u0027), false))\r\n\t\toffset -= 25\r\n}\r\n\r\nreturn offset \u003c= -90 ? offset - 12 : offset"},"EvaluateBeforeScreenRoles":false},{"VariableName":"LastLapTimeOffset","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"if (!isnull($prop(\u0027benofficial2.Relative.LastLapTimeVisible\u0027), false))\r\n\treturn -67\r\n\t\r\nreturn 0"},"EvaluateBeforeScreenRoles":false},{"VariableName":"TireCompoundOffset","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"if (!isnull($prop(\u0027benofficial2.Relative.TireCompoundVisible\u0027), false))\r\n\treturn -22\r\n\t\r\nreturn 0"},"EvaluateBeforeScreenRoles":false},{"VariableName":"StintLapOffset","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"Expression":"if([benofficial2.Relative.StintLapVisible],0,-31)"},"EvaluateBeforeScreenRoles":false},{"VariableName":"variableWidthMax","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"let variableWidthMax = $prop(\u0027variable.dashboardWidth\u0027) - 519\r\n\r\nvariableWidthMax -= $prop(\u0027variable.RatingOffset\u0027)\r\nvariableWidthMax -= $prop(\u0027variable.LastLapTimeOffset\u0027)\r\nvariableWidthMax -= $prop(\u0027variable.TireCompoundOffset\u0027)\r\nvariableWidthMax -= $prop(\u0027variable.StintLapOffset\u0027)\r\n\r\nreturn variableWidthMax"},"EvaluateBeforeScreenRoles":false},{"VariableName":"variableWidth","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"const desiredWidth = isnull($prop(\u0027benofficial2.Relative.Width\u0027), 430) + 75\r\nconst maxWidth = $prop(\u0027variable.dashboardWidth\u0027)\r\nconst variableWidthMax = $prop(\u0027variable.variableWidthMax\u0027)\r\nconst minWidth = maxWidth - variableWidthMax\r\nreturn Math.min(variableWidthMax, Math.max(0, desiredWidth - minWidth))"},"EvaluateBeforeScreenRoles":false},{"VariableName":"headerWidth","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"const variableWidth = $prop(\u0027variable.variableWidth\u0027)\r\nconst variableWidthMax = $prop(\u0027variable.variableWidthMax\u0027)\r\nconst maxHeaderWidth = $prop(\u0027variable.dashboardWidth\u0027)\r\nconst minHeaderWidth = maxHeaderWidth - variableWidthMax\r\nreturn minHeaderWidth + variableWidth"},"EvaluateBeforeScreenRoles":false},{"VariableName":"trackTempWidth","EvaluateOnlyOnce":true,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"Expression":"60"},"EvaluateBeforeScreenRoles":false},{"VariableName":"clockWidth","EvaluateOnlyOnce":true,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"Expression":"79"},"EvaluateBeforeScreenRoles":false},{"VariableName":"headerMiddleWidth","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"const headerWidth = $prop(\u0027variable.headerWidth\u0027)\r\nconst trackTempWidth = $prop(\u0027variable.trackTempWidth\u0027)\r\nconst clockWidth = $prop(\u0027variable.clockWidth\u0027)\r\nreturn headerWidth - trackTempWidth - clockWidth"},"EvaluateBeforeScreenRoles":false},{"VariableName":"headerOffset","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"if (isnull($prop(\u0027benofficial2.Relative.HeaderVisible\u0027), true))\r\n\treturn 32\r\n\t\r\nreturn 0"},"EvaluateBeforeScreenRoles":false},{"VariableName":"trackTime","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"let seconds = isnull($prop(\u0027GameRawData.Telemetry.SessionTimeOfDay\u0027), 0)\r\n\r\n// Normalize seconds to a 24-hour range\r\nseconds = Math.floor(seconds % 86400);\r\n\r\nconst hours = Math.floor(seconds / 3600);\r\nconst minutes = Math.floor((seconds % 3600) / 60);\r\n\r\nconst use24HourFormat = isnull($prop(\u0027benofficial2.ClockFormat24h\u0027), false)\r\nif (use24HourFormat) \r\n{\r\n    // 24-hour format: HH:MM\r\n    return `${String(hours).padStart(2, \u00270\u0027)}:${String(minutes).padStart(2, \u00270\u0027)}`;\r\n}\r\nelse \r\n{\r\n    // 12-hour format: H:MM AM/PM\r\n    const period = hours \u003e= 12 ? \u0027PM\u0027 : \u0027AM\u0027;\r\n    const displayHour = hours % 12 || 12;\r\n\r\n    return `${displayHour}:${String(minutes).padStart(2, \u00270\u0027)} ${period}`;\r\n}"},"EvaluateBeforeScreenRoles":false},{"VariableName":"panelHeight","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":false,"ValueExpression":{"JSExt":1,"Interpreter":1,"Expression":"const maxRows = isnull($prop(\u0027benofficial2.Relative.MaxRows\u0027), 3)\r\nconst footer = isnull($prop(\u0027benofficial2.Relative.FooterVisible\u0027), true)\r\nreturn $prop(\u0027variable.headerOffset\u0027) + (2 * maxRows + 1) * 24 + (footer ? 32 : 6)"},"EvaluateBeforeScreenRoles":false}]},"DashboardDebugManager":{"_dashSettingsStores":{},"WindowPositionSettings":{"IsFullScreen":false,"Position":"2585,338,739,394","TopMost":false,"AllowTransparency":true,"CloseOnMonitorLoss":false,"NoWindowActivate":false}},"Version":2,"Id":"26cfa92c-c28d-4ed7-b3f2-97318af1d008","BaseHeight":328,"BaseWidth":575,"BackgroundColor":"#FF000000","Screens":[{"RenderingSkip":0,"Name":"Screen","InGameScreen":true,"IdleScreen":true,"PitScreen":false,"ScreenId":"12d56db1-30dc-4b34-8846-702d971cf5b6","AllowOverlays":true,"IsForegroundLayer":false,"IsOverlayLayer":false,"OverlayTriggerExpression":{"Expression":""},"ScreenEnabledExpression":{"Expression":""},"OverlayMaxDuration":0,"OverlayMinDuration":0,"IsBackgroundLayer":false,"BackgroundColor":"#00FFFFFF","Items":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","Group":false,"Repetitions":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","Group":false,"Repetitions":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins","IsRectangleItem":true,"BackgroundColor":"#FF2B2B33","BorderStyle":{"RadiusTopLeft":8,"RadiusTopRight":8,"RadiusBottomLeft":8,"RadiusBottomRight":8},"Opacity":100.0,"Height":300.0,"Left":0.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":444.0,"Name":"Panel Fill","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"BackgroundColor":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"return isnull($prop(\u0027benofficial2.BackgroundColor\u0027), \u0027#FF2B2B33\u0027)"},"Mode":2},"Left":{"Formula":{"Expression":"0"},"Mode":2},"Width":{"Formula":{"Expression":"[variable.headerWidth]"},"Mode":2},"Height":{"Formula":{"Expression":"[variable.panelHeight]"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins",