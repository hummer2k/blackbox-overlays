.Plugins","Variables":{"DashboardVariables":[{"VariableName":"relativeIdx","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"return repeatindex() * -1;"},"EvaluateBeforeScreenRoles":false}]},"NextScreenCommand":0,"PreviousScreenCommand":0,"AutoSize":true,"FileName":"Relative Row.djson","InitialScreenIndex":0,"FreezePageChanges":false,"EnableScreenRolesAndActivation":true,"IgnoreSavedScreensEx":true,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":0.0,"Top":103.0,"Visible":true,"BlinkPhasisInverted":false,"Width":575.0,"Name":"Relative Row","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Top":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const maxRows = isnull($prop(\u0027benofficial2.Relative.MaxRows\u0027), 3)\r\nreturn $prop(\u0027variable.headerOffset\u0027) + (maxRows - 1) * 24"},"Mode":2}}}],"Visible":true,"BlinkPhasisInverted":false,"Name":"Ahead Repeat","RenderingSkip":10,"MinimumRefreshIntervalMS":100.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.GroupItem, SimHub.Plugins","ChildsPositioning":0,"ChildsPositioningAlignment":0,"GroupPadding":{},"ChildsMargin":{},"ChildAlignmentHorizontal":0,"ChildAlignmentVertical":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Inter","FontWeight":"Bold","FontSize":15.0,"Text":"RELATIVE","TextColor":"#FFFFCC00","HorizontalAlignment":0,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":9.0,"Top":4.0,"Visible":true,"BlinkPhasisInverted":false,"Width":200.0,"Name":"Title","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.GroupItem, SimHub.Plugins","ChildsPositioning":0,"ChildsPositioningAlignment":0,"GroupPadding":{},"ChildsMargin":{},"ChildAlignmentHorizontal":0,"ChildAlignmentVertical":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.ImageItem, SimHub.Plugins","Image":"Rain Cloud","AutoSize":false,"BackgroundColor":"#00FFFFFF","Height":16.0,"Left":0.0,"Top":4.0,"Visible":true,"BlinkPhasisInverted":false,"Width":16.0,"Name":"Rain Cloud","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Inter","FontWeight":"SemiBold","FontSize":13.0,"Text":"","TextColor":"#FFF2F2F3","HorizontalAlignment":0,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":21.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":41.0,"Name":"Precip Value","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"return (isnull($prop(\u0027GameRawData.Telemetry.Precipitation\u0027), 0) * 100).toFixed(0) + \u0027%\u0027"},"Mode":2}}}],"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":0.0,"Top":4.0,"Visible":true,"BlinkPhasisInverted":false,"Width":62.0,"Name":"Weather Precip","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Left":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"return $prop(\u0027variable.headerWidth\u0027) - 8 - 112 - ((!(isnull($prop(\u0027benofficial2.TrackWetness.HideWhenZero\u0027), true) \u0026\u0026 Math.max(0, (100 / 6) * (isnull($prop(\u0027GameRawData.Telemetry.TrackWetness\u0027), 0) - 1)) == 0)) ? 62 : 0) - 62"},"Mode":2},"Visible":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"return !(isnull($prop(\u0027benofficial2.Precipitation.HideWhenZero\u0027), true) \u0026\u0026 isnull($prop(\u0027GameRawData.Telemetry.Precipitation\u0027), 0) == 0)"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.GroupItem, SimHub.Plugins","ChildsPositioning":0,"ChildsPositioningAlignment":0,"GroupPadding":{},"ChildsMargin":{},"ChildAlignmentHorizontal":0,"ChildAlignmentVertical":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.ImageItem, SimHub.Plugins","Image":"Rain Drops","AutoSize":false,"BackgroundColor":"#00FFFFFF","Height":16.0,"Left":0.0,"Top":4.0,"Visible":true,"BlinkPhasisInverted":false,"Width":16.0,"Name":"Rain Drops","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Inter","FontWeight":"SemiBold","FontSize":13.0,"Text":"","TextColor":"#FFF2F2F3","HorizontalAlignment":0,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":21.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":41.0,"Name":"Wetness Value","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"return (Math.max(0, (100 / 6) * (isnull($prop(\u0027GameRawData.Telemetry.TrackWetness\u0027), 0) - 1))).toFixed(0) + \u0027%\u0027"},"Mode":2}}}],"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":0.0,"Top":4.0,"Visible":true,"BlinkPhasisInverted":false,"Width":62.0,"Name":"Weather Wetness","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Left":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"return $prop(\u0027variable.headerWidth\u0027) - 8 - 112 - 62"},"Mode":2},"Visible":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"return !(isnull($prop(\u0027benofficial2.TrackWetness.HideWhenZero\u0027), true) \u0026\u0026 Math.max(0, (100 / 6) * (isnull($prop(\u0027GameRawData.Telemetry.TrackWetness\u0027), 0) - 1)) == 0)"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.GroupItem, SimHub.Plugins","ChildsPositioning":0,"ChildsPositioningAlignment":0,"GroupPadding":{},"ChildsMargin":{},"ChildAlignmentHorizontal":0,"ChildAlignmentVertical":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.ImageItem, SimHub.Plugins","Image":"Wind-Arrow","AutoSize":false,"BackgroundColor":"#00FFFFFF","Height":16.0,"Left":0.0,"Top":4.0,"Visible":true,"BlinkPhasisInverted":false,"Width":16.0,"Name":"Wind Arrow","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Rotation":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"const wind = isnull($prop(\u0027GameRawData.Telemetry.WindDir\u0027), 0);\r\nconst windDeg = (wind * 180) / Math.PI + 180;\r\n\r\nconst rotate = isnull($prop(\u0027benofficial2.Wind.RotateWithCar\u0027), true);\r\nif (!rotate) return windDeg;\r\n\r\nconst yaw = isnull($prop(\u0027GameRawData.Telemetry.YawNorth\u0027), 0);\r\nconst yawDeg = (yaw * 180) / Math.PI;\r\n\r\nconst relDeg = windDeg - yawDeg;\r\nreturn relDeg;"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Inter","FontWeight":"SemiBold","FontSize":13.0,"Text":"","TextColor":"#FFF2F2F3","HorizontalAlignment":0,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":21.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":91.0,"Name":"Wind Value","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"const windVelMs = isnull($prop(\u0027GameRawData.Telemetry.WindVel\u0027), 0);\r\nconst windDir = isnull($prop(\u0027GameRawData.Telemetry.WindDir\u0027), 0);\r\nconst windDirName = windDirectionFromRadians(windDir);\r\n\r\nif ($prop(\u0027SpeedLocalUnit\u0027) == \u0027KMH\u0027)\r\n{\r\n\tconst windVelKmh = windVelMs * 3.6;\r\n\treturn windDirName + \u0027 \u0027 + windVelKmh.toFixed(0) + \u0027 km/h\u0027;\r\n}\r\n\r\nconst windVelMph = windVelMs * 2.23694;\r\nreturn windDirName + \u0027 \u0027 + windVelMph.toFixed(0) + \u0027 mph\u0027;","PreExpression":"function windDirectionFromRadians(radians) \r\n{\r\n\t// Convert rad to degrees\r\n    const degrees = (radians * 180) / Math.PI;\r\n    const normalizedDegrees = (degrees + 360) % 360;\r\n    \r\n    // Each direction covers 45 degrees\r\n    const directions = [\u0027N\u0027, \u0027NE\u0027, \u0027E\u0027, \u0027SE\u0027, \u0027S\u0027, \u0027SW\u0027, \u0027W\u0027, \u0027NW\u0027];\r\n    const index = Math.round(normalizedDegrees / 45) % 8;\r\n    return directions[index];\r\n}"},"Mode":2}}}],"BackgroundColor":"#00FFFFFF","Height":24.0,"Left":0.0,"Top":4.0,"Visible":true,"BlinkPhasisInverted":false,"Width":112.0,"Name":"Weather Wind","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Left":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"return $prop(\u0027variable.headerWidth\u0027) - 8 - 112"},"Mode":2}}}],"BackgroundColor":"#00FFFFFF","Height":32.0,"Left":0.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":469.0,"Name":"Header","RenderingSkip":50,"MinimumRefreshIntervalMS":500.0,"Bindings":{"Visible":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"return isnull($prop(\u0027benofficial2.Relative.HeaderVisible\u0027), true);"},"Mode":2},"Width":{"Formula":{"Expression":"[variable.headerWidth]"},"Mode":2}}}],"Visible":true,"BlinkPhasisInverted":false,"Name":"Visible","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"if (!isnull($prop(\u0027benofficial2.iRacingRunning\u0027), false))\r\n\treturn false\r\n\t\r\nconst hideInReplay = isnull($prop(\u0027benofficial2.Relative.HideInReplay\u0027), true)\r\nconst replayPlaying = isnull($prop(\u0027benofficial2.Session.ReplayPlaying\u0027), false)\r\n\r\nif (hideInReplay \u0026\u0026 replayPlaying)\r\n\treturn false\r\n\t\r\nreturn true"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":12.0,"Text":"New version available","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#FFFF0000","BorderStyle":{"RadiusTopLeft":3,"RadiusTopRight":3,"RadiusBottomLeft":3,"RadiusBottomRight":3},"Height":18.0,"Left":54.0,"Top":0.0,"Visible":false,"BlinkPhasisInverted":false,"Width":205.0,"IsFreezed":true,"Name":"Version","RenderingSkip":50,"MinimumRefreshIntervalMS":500.0,"Bindings":{"Visible":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"return checkVersion(g_VersionName, g_VersionNumber) || getErrorMessage() != \u0027\u0027","PreExpression":"// Download new version at https://github.com/fixfactory/bo2-official-overlays\r\nconst g_VersionName = \u0027relative\u0027\r\nconst g_VersionNumber = \u00275.2\u0027"},"Mode":2},"Text":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const errorMessage = getErrorMessage()\r\nreturn errorMessage != \u0027\u0027 ? errorMessage : \"New version available\""},"Mode":2}}}],"MinimumRefreshIntervalMS":0.0}],"SnapToGrid":false,"HideLabels":true,"ShowForeground":true,"ForegroundOpacity":100.0,"ShowBackground":true,"BackgroundOpacity":100.0,"ShowBoundingRectangles":false,"GridSize":5,"Images":[{"Name":"road-white","Extension":".png","Modified":false,"Optimized":true,"Width":94,"Height":94,"Length":6898,"MD5":"5ac19fda7a1c5cd0aa4f364ab3a2a34e"},{"Name":"clock","Extension":".png","Modified":false,"Optimized":true,"Width":2070,"Height":2081,"Length":20449,"MD5":"2c32cae47ab42de69919374d77650a09"},{"Name":"x big round","Extension":".png","Modified":false,"Optimized":true,"Width":5860,"Height":5860,"Length":358011,"MD5":"e64dad1a6e64a78c3133fad8d8f763dc"},{"Name":"SOF","Extension":".png","Modified":false,"Optimized":true,"Width":266,"Height":199,"Length":2202,"MD5":"0cebc57e989e3fdc1a8b7544b99b047b"},{"Name":"Helmet","Extension":".png","Modified":false,"Optimized":true,"Width":99,"Height":87,"Length":1373,"MD5":"7a03a232df04e517c33e35fd696b0e6c"},{"Name":"Rain Cloud","Extension":".png","Modified":false,"Optimized":true,"Width":266,"Height":266,"Length":6253,"MD5":"b01a7386f0d551529886dc306e88c17b"},{"Name":"Rain Drops","Extension":".png","Modified":false,"Optimized":true,"Width":266,"Height":266,"Length":7857,"MD5":"df85c06c03a464a97916991d9dbd295f"},{"Name":"Wind-Arrow","Extension":".png","Modified":false,"Optimized":true,"Width":266,"Height"